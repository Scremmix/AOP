.tabellaRegolamento{
    width: 90%;
    margin: 1vw 5%;
    border-radius: 1vw;
    display: flex;
    flex-direction: column;
    grid-template-columns: 25% 50% 25%;
    background-color: rgba(255, 255, 255, 0.1);
}

.tabellaRegolamento .subPageTitle{
    padding: 0.15rem 0;
    width: 100%;
    font-size: clamp(0.8rem,calc(1.9vw + .7rem),2.5rem);
    color: #85bdfc;
    text-shadow: 0 0 8px #cae2fd;
    text-align: center;
}

.tabellaRegolamento .content{
    font-size: clamp(0.7rem,calc(1.3vw + .6rem),2.2rem);
    padding: 0.2rem 2.5%;
    width: 95%;
    color: #cae2fd;
    text-align: center;
}